{
  "editor.rulers": [120],
  // 🧹 Formateo automático al guardar el archivo
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  //"editor.fontFamily": "'MesloLGL Nerd Font', Consolas, 'Courier New', monospace",
  //"editor.fontFamily": "'JetBrainsMonoNL Nerd Font Mono', 'FiraCode Nerd Font', monospace",
  "editor.fontFamily": "'Google Sans Code', Consolas, monospace",
  //"editor.fontFamily": "'Hack Nerd Font Mono', Consolas, 'Courier New', monospace",
  //"editor.fontFamily": "'FiraCode Nerd Font', 'Courier New', monospace",
  //"editor.fontFamily": "'FiraMono Nerd Font', 'Courier New', monospace",
  //"editor.fontFamily": "'Victor Mono', 'Courier New', monospace",
  //"editor.fontFamily": "Inconsolata, Consolas, monospace",
  //"editor.fontFamily": "GohuFont 11 Nerd Font Mono",
  // "editor.fontFamily": "GohuFont 14 Nerd Font Mono",
  // 📐 Configuración de PHP CodeSniffer / PHPCBF
  "phpcs.enable": true,
  "phpcs.executablePath": "./vendor/bin/phpcs",
  "phpcs.standard": "phpcs.xml",
  // 🪄 Corrección automática de formato mediante PHPCBF al guardar
  "phpcbf.enable": true,
  "phpcbf.executablePath": "./vendor/bin/phpcbf",
  "phpcbf.standard": "phpcs.xml",
  "phpcbf.onsave": true,
  // 🧠 Configuración de PHPStan para análisis estático en tiempo real
  "phpstan.enabled": true,
  "phpstan.binPath": "./vendor/bin/phpstan",
  "phpstan.configFile": "phpstan.neon",
  // 🎨 Formato visual de líneas y reglas de estilo PHP
  "[php]": {
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "junstyle.php-cs-fixer"
  },
  "php-cs-fixer.executablePath": "${workspaceFolder}/vendor/bin/php-cs-fixer",
  "php-cs-fixer.config": "${workspaceFolder}/.php-cs-fixer.php",
  "php-cs-fixer.onsave": true
}
